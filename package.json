{
  "name": "collectflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@collectflow/api",
    "dev:web": "npm run dev --workspace=@collectflow/web",
    "build": "npm run build --workspaces",
    "db:generate": "npm run db:generate --workspace=@collectflow/database",
    "db:migrate": "npm run db:migrate --workspace=@collectflow/database",
    "db:seed": "npm run db:seed --workspace=@collectflow/database"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
